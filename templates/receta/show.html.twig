{% extends 'base.html.twig' %}

{% block title %}Receta{% endblock %}

{% block body %}
    <h2>Receta</h2>

    <table class="table">
        <tbody>
            <tr>
                <th>Título</th>
                <td>{{ recetum.titulo }}</td>
            </tr>
            <tr>
                <th>Ingredientes</th>
                <td>
                {% for ingrediente in recetum.ingredientes %} 
                {{ ingrediente }},
                {% endfor %}
                </td>
            </tr>            
            <tr>
                <th>Notas</th>
                <td>{{ recetum.notas|raw }}</td>
            </tr>
        </tbody>
    </table>
 
    {% if is_granted('ROLE_USER') %}
        {% if app.user == recetum.user or is_granted('ROLE_ADMIN') %}
            <p><a href="{{ path('app_receta_edit', {'id': recetum.id}) }}" class="button primary">Editar</a></p>
            <p>{{ include('receta/_delete_form.html.twig') }}</p>
        {% endif %}    
        
        {#<p><a href="{{ path('app_menu_new', {fechaHora: 0, receta: recetum.id}) }}" class="button primary">+Menú</a></p>#}

    {% endif %}
    
    <p><a href="{{ path('app_receta_index') }}" class="button primary">Volver al listado</a></p>
        
{% endblock %}
